# Copy this file to .env and add your own credentials.
NVD_API_KEY=

# Text-to-SQL and final-answer provider order: Groq, Gemini, Mistral.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

TEXTSQL_PROVIDER=groq
TEXTSQL_MODEL=

# Supabase PostgreSQL session-pooler connection string. Leave blank for SQLite.
SUPABASE_DB_URL=

# Qdrant Cloud. Leave both blank to use the existing local data/qdrant index.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sentinelprior_cve_rag
